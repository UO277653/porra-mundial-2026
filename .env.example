# Copia este archivo a .env y rellena con los datos de tu proyecto Supabase
# (Settings → API). Sin esto la app funciona en MODO DEMO con datos de ejemplo.
VITE_SUPABASE_URL=https://tuproyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Solo para ejecutar la sincronización en local (npm run sync).
# En GitHub van como "secrets", nunca subas este archivo.
FOOTBALL_DATA_TOKEN=tu_token_de_football-data.org
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
